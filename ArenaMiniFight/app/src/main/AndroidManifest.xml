<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".GameApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArenaMiniFight">

        <!-- Background Game Service (Multi-process support) -->
        <service
            android:name=".service.GameService"
            android:enabled="true"
            android:exported="false"
            android:process=":game" />

        <!-- Splash Screen Activity (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ArenaMiniFight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Menu Activity -->
        <activity
            android:name=".ui.menu.MenuActivity"
            android:exported="false" />

        <!-- Core Gameplay Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <!-- Leaderboard Activity -->
        <activity
            android:name=".ui.leaderboard.LeaderboardActivity"
            android:exported="false" />

        <!-- About Activity -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false" />

    </application>

</manifest>
