<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10141D"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="@string/app_name"
        android:textColor="#00E5FF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_start_game"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="#00E5FF"
        android:text="@string/menu_start_game"
        android:textColor="#10141D"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_setting"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#8C52FF"
        android:text="@string/menu_setting"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_leaderboard"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#8C52FF"
        android:text="@string/menu_leaderboard"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_about"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#29CC6A"
        android:text="@string/menu_about"
        android:textColor="#10141D"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
