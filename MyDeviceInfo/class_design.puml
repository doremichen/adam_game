@startuml
' --- Configuration ---
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 80
skinparam shadowing false

' --- UI Layer ---
package "UI Layer" #E8F5E9 {
    package "ui.main" {
        class MainActivity
        class MainViewModel
    }

    package "ui.dashboard" {
        class DashboardFragment
        class DashboardViewModel
    }

    package "ui.system" {
        class SystemFragment
        class SystemViewModel
    }

    package "ui.network" {
        class NetworkFragment
        class NetworkViewModel
    }

    package "ui.tools" {
        class ToolsFragment
        class ToolsViewModel
    }

    class SingleLiveEvent <<Utility>>
}

' --- Application Layer ---
package "Application Layer" #E1F5FE {
    class InfoUseCase <<UseCase>> {
        + execute(action: Action, data: Object): T
    }
    enum Action {
        FETCH_ALL_INFO
        SUBSCRIBE_INFO
        EXPORT_REPORT
        EXECUTE_HW_TEST
    }
    InfoUseCase +-- Action
}

' --- Domain Layer ---
package "Domain Layer" #FEFECE {
    interface IDeviceRepository <<Interface>> {
        + fetchDeviceInfo()
        + getDeviceInfoStream()
        + exportDeviceInfo()
        + runHardwareTest()
    }

    class DeviceInfo <<Entity>>
    class DashboardData <<VO>>
    class SystemSpecs <<VO>>
    class NetworkStatus <<VO>>

    package "Enums (Mapping)" {
        enum ConnectivityState
        enum SimState
        enum BatteryStatus
        enum BatteryHealth
    }

    DeviceInfo *-- DashboardData
    DeviceInfo *-- SystemSpecs
    DeviceInfo *-- NetworkStatus
}

' --- Infrastructure Layer ---
package "Infrastructure Layer" #FFF9C4 {
    class InfoRepositoryImpl <<Implementation>>
    class InfoService <<Android Service>>

    package "IPC Contracts (AIDL)" {
        interface IInfoService
        interface IInfoCallback
        class DeviceStateDto <<Parcelable>>
    }
}

' --- Layout Hints ---
"UI Layer" -[hidden]down-> "Application Layer"
"Application Layer" -[hidden]down-> "Domain Layer"
"Domain Layer" -[hidden]down-> "Infrastructure Layer"

' --- Relationships ---

' UI Relationships
MainActivity --> MainViewModel
MainActivity ..> DashboardFragment : "hosts"
DashboardFragment --> DashboardViewModel
SystemFragment --> SystemViewModel
NetworkFragment --> NetworkViewModel
ToolsFragment --> ToolsViewModel

' UI -> Application
DashboardViewModel --> InfoUseCase : "SUBSCRIBE_INFO"
SystemViewModel --> InfoUseCase : "SUBSCRIBE_INFO"
NetworkViewModel --> InfoUseCase : "SUBSCRIBE_INFO"
ToolsViewModel --> InfoUseCase : "EXPORT_REPORT / HW_TEST"

' Application -> Domain
InfoUseCase --> IDeviceRepository : "executes contract"

' Domain -> Infrastructure
InfoRepositoryImpl ..|> IDeviceRepository : "implements"

' Infrastructure Internal
InfoRepositoryImpl --> IInfoService : "AIDL Proxy"
InfoService o-- IInfoCallback : "broadcasts"
InfoService ..> DeviceStateDto : "populates"
InfoRepositoryImpl ..> DeviceStateDto : "maps to Entity"

' Cross-layer Dependency on Enums
InfoService --> ConnectivityState : "determines status"
NetworkViewModel --> ConnectivityState : "maps to UI string"

@enduml
