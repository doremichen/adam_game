@startuml
skinparam linetype ortho
skinparam packageStyle rectangle

package "Domain Layer" #FEFECE {
    interface IDeviceRepository
    class DeviceInfo
}

package "Application Layer" #E1F5FE {
    class InfoUseCase
}

package "Infrastructure Layer" #FFF9C4 {
    class InfoService
    class InfoRepositoryImpl
    package "IPC Contracts" {
        interface IInfoService
        interface IInfoCallback
    }
}

package "UI / Presentation Layer" #E8F5E9 {
    class MainActivity
    package "Feature ViewModels" as FVM {
        class DashboardViewModel
        class SystemViewModel
        class NetworkViewModel
        class ToolsViewModel
    }
}

' High-level data flow
InfoUseCase --> IDeviceRepository : "uses"
InfoRepositoryImpl ..|> IDeviceRepository : "implements"
FVM --> InfoUseCase : "executes actions"
InfoRepositoryImpl --> IInfoService : "AIDL Proxy"
InfoService o-- IInfoCallback : "broadcasts"
InfoRepositoryImpl --|> IInfoCallback : "callback receiver"

@enduml
