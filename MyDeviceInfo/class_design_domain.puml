@startuml
skinparam linetype ortho
skinparam packageStyle rectangle

package "Domain Layer" {
    class DeviceInfo <<Entity>> {
        - mDashboardData: DashboardData
        - mSystemSpecs: SystemSpecs
        - mNetworkStatus: NetworkStatus
    }

    class DashboardData <<Value Object>> {
        - mRamUsed/Total: long
        - mStorageUsed/Total: long
        - mBatteryPct/Temp/Volt: String
        - mBatteryStatus/Health: String
        - mUptime: long
    }

    class SystemSpecs <<Value Object>> {
        - mManufacturer: String
        - mModel/Codename: String
        - mDisplayMetrics: String
        - mOsVersion/Api: String
        - mSecurityPatch: String
        - mKernel/Fingerprint: String
        - mCpuAbi/Cores: String
        - mSensorList: List<String>
    }

    class NetworkStatus <<Value Object>> {
        - mWifiStatus: String
        - mIpV4/IpV6: String
        - mWifiSignal/LinkSpeed: String
        - mCarrierName: String
        - mNetworkType: String
        - mSimStatus: String
        - mBluetooth/NfcStatus: String
    }

    interface IDeviceRepository <<Interface>> {
        + fetchDeviceInfo(): DeviceInfo
        + getDeviceInfoStream(): LiveData<DeviceInfo>
        + exportDeviceInfo(info: DeviceInfo): boolean
        + runHardwareTest(type: int): void
    }

    DeviceInfo *-- DashboardData
    DeviceInfo *-- SystemSpecs
    DeviceInfo *-- NetworkStatus
}
@enduml
