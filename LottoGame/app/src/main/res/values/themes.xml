<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LottoGame" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="LottoButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/purple_200</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ResultTextViewStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/material_on_surface_emphasis_medium</item>
    </style>


    <style name="LottoButtonStyle.Secondary" parent="LottoButtonStyle">
        <item name="android:backgroundTint">@color/material_on_surface_disabled</item>
        <item name="android:textColor">@color/material_on_primary_emphasis_high_type</item>
    </style>


</resources>