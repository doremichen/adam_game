@startuml "System Overview"
header Galaga Project Architecture
footer Page 1 of 3
top to bottom direction

skinparam packageStyle rectangle

package "Presentation Layer" as PL #LightBlue
package "Domain Layer" as DL #LightGreen
package "Data Layer" as DT #LightYellow
package "Engine Layer" as EL #LightCoral

PL ..> DL : depends on
DL ..> DT : interface impl
PL ..> EL : control/observe
EL ..> DT : load config
@enduml

@startuml "App Architecture (Clean + MVVM)"
header Presentation, Domain & Data Layers
footer Page 2 of 3
top to bottom direction

skinparam class {
    BackgroundColor white
    ArrowColor Black
    BorderColor DarkBlue
}

package "Presentation Layer" {
    class MainActivity
    class MainViewModel
    class GameActivity
    class GameViewModel
    class LeaderboardActivity
    class LeaderboardViewModel
    class SettingsActivity
    class SettingsViewModel
}

package "Domain Layer" {
    interface IUseCase <<Interface>>

    class GameUseCase
    class SettingsUseCase
    class UseCaseBridge <<Bridge>>

    interface IGameRepository <<Boundary>>
    interface ILevelRepository <<Boundary>>
    interface ISettingsRepository <<Boundary>>

    class "UseCase.Request" as UCR <<DTO>>
}

package "Data Layer" {
    class GameRepository
    class LevelRepository
    class SettingsRepository

    class AppDatabase <<Room>>
    class GameSettings <<Prefs>>
    class AssetProvider <<assets>>
}

' Positioning (UI to VM)
MainActivity .down.> MainViewModel : Data Binding
GameActivity .down.> GameViewModel : Data Binding
LeaderboardActivity .down.> LeaderboardViewModel : Observe State
SettingsActivity .down.> SettingsViewModel : Observe State

' VM to UseCase Interaction
MainViewModel -down-> GameUseCase : execute(Request)
GameViewModel -down-> GameUseCase : execute(Request)
LeaderboardViewModel -down-> GameUseCase : execute(Request)
SettingsViewModel -down-> SettingsUseCase : execute(Request)

' UseCase Implementation
GameUseCase ..|> IUseCase
SettingsUseCase .up.|> IUseCase

GameUseCase -down-> UseCaseBridge
SettingsUseCase -down-> UseCaseBridge

' Bridge to Repository Interfaces
UseCaseBridge -down-> IGameRepository
UseCaseBridge -down-> ILevelRepository
UseCaseBridge -down-> ISettingsRepository

' Repository Interface Implementations
GameRepository .up.|> IGameRepository
LevelRepository .up.|> ILevelRepository
SettingsRepository .up.|> ISettingsRepository

' Data Layer Logic
GameRepository -down-> AppDatabase
LevelRepository -down-> AssetProvider
SettingsRepository -down-> GameSettings

@enduml

@startuml "Game Engine Architecture"
header Engine, Patterns & Game Objects
footer Page 3 of 3
top to bottom direction

skinparam class {
    BackgroundColor white
    ArrowColor Black
    BorderColor DarkBlue
}

package "Engine Layer" {
    class GameEngine <<Core>>
    class GameObjectManager <<Facade>>
    class EnemySpawner

    package "Spawning (CoR)" {
        abstract class SpawnHandler
        class NewWaveHandler
        class WaveInProgressHandler
    }

    package "Behavior Patterns" {
        interface EnemyEntryStrategy <<Strategy>>
        interface BeeState <<State>>
    }

    package "Models" {
        abstract class GameObject
        class Bee
        class Plane
        class Bullet
    }
}

' Connections
GameEngine -down-> GameObjectManager : control
GameObjectManager -down-> EnemySpawner : spawn request
GameObjectManager -right-> GameObject : update/draw

EnemySpawner -down-> SpawnHandler
SpawnHandler <|-- NewWaveHandler
SpawnHandler <|-- WaveInProgressHandler

GameObject <|-- Bee
GameObject <|-- Plane
GameObject <|-- Bullet

Bee -down-> BeeState
Bee -down-> EnemyEntryStrategy
@enduml
