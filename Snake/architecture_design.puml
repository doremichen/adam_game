' --- Page 2: Domain Model ---
title Snake Game Architecture - Domain Model

package model {
    class SnakeGame {
        - mSnake: Snake
        - mSpecialFoods: List<SpecialFood>
        - mGameState: GameState
        - mScore: int
        + update()
        + start()
        + stop()
        + reset()
        + setDirection(Direction)
    }

    class Snake {
        - mBody: List<Point>
        - mDirection: Direction
        - mIsInvisible: boolean
        - mIsInvincible: boolean
        + move()
        + grow()
        + checkCollision()
    }

    class SpecialFood {
        - mPosition: Point
        - mType: FoodType
        - mResId: int
    }

    enum Direction {
        UP
        DOWN
        LEFT
        RIGHT
    }

    enum GameState {
        IDLE
        RUNNING
        PAUSED
        GAME_OVER
    }

    SnakeGame "1" *-- "1" Snake : contains
    SnakeGame "1" *-- "*" SpecialFood : manages
    Snake "1" --> "1" Direction : oriented
    SnakeGame ..> GameState : state
}

