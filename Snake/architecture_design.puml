' --- Page 3: MVVM Interaction ---
title Snake Game Architecture - MVVM Interaction Flow

package Presentation {
    class ViewComponent
    class SettingActivity
    class SnakeViewModel
    class SettingViewModel
}

package Domain {
    class LeaderboardUseCase
    class SettingUseCase
    interface ILeaderboardRepository
    interface ISettingRepository
}

package Data {
    class LeaderboardRepositoryImpl
    class SettingRepositoryImpl
    class RoomDatabase
    class SharedPreferencesManager
}

' Interaction Flow
ViewComponent -right-> SnakeViewModel : observes LiveData
SnakeViewModel -right-> LeaderboardUseCase : executes
SnakeViewModel -down-> SettingUseCase : executes
SettingActivity -right-> SettingViewModel : uses Data Binding
SettingViewModel -right-> SettingUseCase : executes

LeaderboardUseCase -right-> ILeaderboardRepository : calls
SettingUseCase -right-> ISettingRepository : calls

LeaderboardRepositoryImpl .up.|> ILeaderboardRepository : implements
SettingRepositoryImpl .up.|> ISettingRepository : implements

LeaderboardRepositoryImpl -right-> RoomDatabase : CRUD
SettingRepositoryImpl -right-> SharedPreferencesManager : CRUD

note top of LeaderboardUseCase
  **Enum-based UseCase Pattern**
  - GET_TOP_SCORES
  - SAVE_SCORE
  - CLEAR_ALL
end note

note top of SettingUseCase
  **Enum-based UseCase Pattern**
  - GET_SETTING
  - SAVE_SETTING
end note

note bottom of SnakeViewModel
  **Hilt Injected**
  ViewModels no longer access
  Repositories directly.
end note

@enduml
