<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.adam.app.snake.presentation.viewmodel.AboutViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F0F1E"
        android:fitsSystemWindows="true"
        tools:context=".presentation.ui.AboutActivity">

        <!-- Retro Background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_welcome_gradient"
            android:alpha="0.8"/>

        <!-- Title: Neon Arcade Style -->
        <TextView
            android:id="@+id/tvAboutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snake_game_about_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#00FF41"
            android:letterSpacing="0.1"
            android:shadowColor="#000000"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp" />

        <!-- Instruction Area in a Framed Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardInstructions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1A1A2E"
            app:layout_constraintTop_toBottomOf="@id/tvAboutTitle"
            app:layout_constraintBottom_toTopOf="@id/btnExitAbout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/tvInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/snake_game_instructions"
                    android:textSize="17sp"
                    android:textColor="#E0E0E0"
                    android:lineSpacingMultiplier="1.4"
                    android:fontFamily="sans-serif-medium" />
            </ScrollView>
        </androidx.cardview.widget.CardView>

        <!-- Arcade Style Exit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitAbout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/snake_game_exit_btn"
            android:onClick="@{() -> viewModel.onExitClick()}"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#E74C3C"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_menu_revert"
            app:iconGravity="textStart"
            android:elevation="6dp"
            android:layout_marginHorizontal="56dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
