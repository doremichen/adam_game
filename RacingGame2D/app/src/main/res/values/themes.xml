<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RacingGame2D" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.RacingGame2D" parent="Base.Theme.RacingGame2D" />

    <style name="GameTitleStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="GameButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@drawable/game_button_background</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="GameLabelStyle">
        <item name="android:textColor">#E0E0E0</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GameContentStyle">
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="GameCapsuleButtonStyle" parent="GameButtonStyle">
        <item name="android:background">@drawable/game_button_capsule_background</item>
        <item name="android:paddingStart">48dp</item>
        <item name="android:paddingEnd">48dp</item>
    </style>

    <style name="GameEditTextStyle">
        <item name="android:background">@drawable/game_edittext_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">#88FFFFFF</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>