<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="record"
            type="com.adam.app.racinggame2d.domain.entity.LeaderboardRecord" />

        <variable
            name="rank"
            type="Integer" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#33FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#44FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Rank -->
            <TextView
                android:id="@+id/tvRank"
                style="@style/GameLabelStyle"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@{String.valueOf(rank)}"
                tools:text="1" />

            <!-- Player Name -->
            <TextView
                android:id="@+id/tvName"
                style="@style/GameLabelStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start"
                android:singleLine="true"
                android:text="@{record.playerName}"
                tools:text="Player" />

            <!-- Score -->
            <TextView
                android:id="@+id/tvScore"
                style="@style/GameLabelStyle"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@{String.valueOf(record.score)}"
                tools:text="9999" />

            <!-- Time -->
            <TextView
                android:id="@+id/tvTime"
                style="@style/GameContentStyle"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingStart="8dp"
                android:textSize="12sp"
                android:text="@{record.timestamp}"
                tools:text="2025/11/05" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</layout>
